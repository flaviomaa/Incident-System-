    {
      "parameters": {
        "jsCode": "const sourceData = $('Code in JavaScript1').first().json;\nconst llmData = $('Message a model').first().json;\n\nconst rawText = llmData.content?.[0]?.text;\n\nif (!rawText) {\n  throw new Error('LLM output missing: Message a model -> content[0].text not found');\n}\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(rawText);\n} catch (error) {\n  throw new Error('LLM output is not valid JSON: ' + error.message);\n}\n\nconst aiUrgency = parsed.aiUrgency ?? null;\nconst urgent = sourceData.urgent === true;\n\nlet finalUrgency = aiUrgency;\n\nif (aiUrgency === 'critical') {\n  finalUrgency = 'critical';\n} else if (urgent) {\n  finalUrgency = 'high';\n} else if (!['low', 'medium', 'high', 'critical'].includes(aiUrgency)) {\n  finalUrgency = 'medium';\n}\n\nreturn [\n  {\n    json: {\n      ...sourceData,\n      validationState: parsed.validationState ?? null,\n      incidentType: parsed.incidentType ?? null,\n      aiUrgency: aiUrgency,\n      finalUrgency: finalUrgency,\n      confidence: parsed.confidence ?? null,\n      description: parsed.description ?? sourceData.description ?? null,\n      incidentDate: parsed.incidentDate ?? null,\n      incidentTime: parsed.incidentTime ?? null\n    }\n  }\n];"
      },
